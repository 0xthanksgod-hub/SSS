# Salin menjadi .env lalu isi. JANGAN commit file .env.
# Di Vercel/Railway, isi semua ini di dashboard (Environment Variables), bukan file .env.
PORT=3000
NODE_ENV=development

# --- Rekening toko: HANYA data awal ---
# Dipakai saat database masih kosong. Setelah itu diubah lewat Admin -> Pembayaran.
BANK_NAME=
BANK_ACCOUNT_NUMBER=
BANK_ACCOUNT_HOLDER=

# --- Login admin ---
ADMIN_EMAIL=admin@rimbacamp.id
ADMIN_PASSWORD=ganti-dengan-password-kuat-min-12-karakter
# Acak panjang: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Enkripsi nomor identitas (AES-256-GCM, 32 byte base64) ---
# Buat: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Jika kosong, nomor identitas penuh tidak disimpan (hanya 4 digit terakhir).
IDENTITY_ENCRYPTION_KEY=

# Lama stok ditahan menunggu transfer (menit). Default 180.
HOLD_MINUTES=180

# --- Vercel: diisi otomatis saat database Upstash Redis dihubungkan ---
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Folder data (db.json + foto bukti) bila TIDAK memakai Redis. Lokal: kosongkan (pakai server/data).
# Railway: pasang Volume; path-nya otomatis dipakai dari RAILWAY_VOLUME_MOUNT_PATH.
DATA_DIR=
