generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum BookingStatus {
  PENDING_PAYMENT
  BOOKED
  PICKED_UP
  COMPLETED
  EXPIRED
  CANCELLED
  REJECTED
}

enum IdentityType {
  KTP
  SIM
  PASSPORT
}

enum PickupRule {
  DAY_BEFORE
  SAME_DAY
}

enum PaymentStatus {
  PENDING
  SETTLEMENT
  EXPIRE
  CANCEL
  DENY
  REFUND
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          Role      @default(CUSTOMER)
  accounts      Account[]
  sessions      Session[]
  bookings      Booking[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refreshToken      String? @db.Text
  accessToken       String? @db.Text
  expiresAt         Int?
  tokenType         String?
  scope             String?
  idToken           String? @db.Text
  sessionState      String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id             String           @id @default(cuid())
  categoryId     String
  name           String
  slug           String           @unique
  description    String           @db.Text
  specifications Json
  dailyPrice     Int
  totalStock     Int
  isActive       Boolean          @default(true)
  category       Category         @relation(fields: [categoryId], references: [id])
  images         ProductImage[]
  bookingItems   BookingItem[]
  stockBlocks    StockBlock[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([categoryId, isActive])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  storageKey String
  altText   String
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model StockBlock {
  id        String   @id @default(cuid())
  productId String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  quantity  Int
  reason    String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([productId, startDate, endDate])
}

model Booking {
  id                  String          @id @default(cuid())
  code                String          @unique
  userId              String
  status              BookingStatus   @default(PENDING_PAYMENT)
  startDate           DateTime        @db.Date
  endDate             DateTime        @db.Date
  rentalDays          Int
  subtotal            Int
  total               Int
  holdExpiresAt       DateTime?
  pickupAt            DateTime
  pickupSlotId        String
  identityId          String?         @unique
  identityAcceptedAt  DateTime?
  identityReturnedAt  DateTime?
  rejectionReason     String?
  damageNote          String?
  lateFee             Int             @default(0)
  user                User            @relation(fields: [userId], references: [id])
  pickupSlot          PickupSlot      @relation(fields: [pickupSlotId], references: [id])
  identity            IdentityRecord?
  items               BookingItem[]
  payments            Payment[]
  statusLogs           BookingStatusLog[]
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@index([status, startDate, endDate])
  @@index([pickupAt, status])
  @@index([holdExpiresAt, status])
}

model BookingItem {
  id             String  @id @default(cuid())
  bookingId      String
  productId      String
  quantity       Int
  dailyPrice     Int
  lineTotal      Int
  booking        Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  product        Product @relation(fields: [productId], references: [id])

  @@unique([bookingId, productId])
  @@index([productId])
}

model IdentityRecord {
  id                     String       @id @default(cuid())
  bookingId              String       @unique
  fullName               String
  type                   IdentityType
  encryptedIdentityNumber String      @db.Text
  identityNumberLastFour String
  whatsapp               String
  privatePhotoStorageKey String
  consentedAt            DateTime
  booking                Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  createdAt              DateTime     @default(now())
}

model PickupSlot {
  id        String    @id @default(cuid())
  startsAt  DateTime
  endsAt    DateTime
  capacity  Int
  isActive  Boolean   @default(true)
  bookings Booking[]

  @@unique([startsAt, endsAt])
  @@index([startsAt, isActive])
}

model StoreSetting {
  id              String     @id @default("default")
  storeName       String
  address         String
  whatsapp        String
  timezone        String     @default("Asia/Jakarta")
  pickupRule      PickupRule @default(DAY_BEFORE)
  openTime        String     @default("08:00")
  closeTime       String     @default("20:00")
  slotMinutes     Int        @default(60)
  slotCapacity    Int        @default(5)
  holdMinutes     Int        @default(15)
  updatedAt       DateTime   @updatedAt
}

model Payment {
  id                    String        @id @default(cuid())
  bookingId             String
  midtransOrderId       String        @unique
  snapToken             String?
  status                PaymentStatus @default(PENDING)
  amount                Int
  transactionId         String?       @unique
  paymentType           String?
  settlementAt          DateTime?
  rawNotification       Json?
  booking               Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
}

model WebhookEvent {
  id          String   @id @default(cuid())
  provider    String
  eventKey    String   @unique
  signature   String
  payload     Json
  processedAt DateTime?
  createdAt   DateTime @default(now())
}

model BookingStatusLog {
  id        String        @id @default(cuid())
  bookingId String
  from      BookingStatus?
  to        BookingStatus
  actorId   String?
  note      String?
  booking   Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@index([bookingId, createdAt])
}
